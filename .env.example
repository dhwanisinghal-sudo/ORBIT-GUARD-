# Copy to .env (never commit .env) and fill in.

# REQUIRED. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ORBITGUARD_SECRET=

# Browser origins allowed to call the API (comma-separated, no trailing path).
# Default if unset: http://localhost:5173,http://127.0.0.1:5173
ORBITGUARD_CORS_ORIGINS=https://your-frontend.example.com

# Set to 1 ONLY when the API sits behind exactly one reverse proxy that sets X-Forwarded-For.
# ORBITGUARD_TRUST_PROXY=1

# Background job that precomputes watchlist alerts and pushes them over /ws/alerts (all optional).
# ORBITGUARD_ALERT_JOB=1            # 0 turns the job off
# ORBITGUARD_ALERT_INTERVAL=300     # seconds between refreshes (min 30)
# ORBITGUARD_ALERT_GROUP=active
# ORBITGUARD_ALERT_HOURS=24
# ORBITGUARD_ALERT_THRESHOLD_KM=5
